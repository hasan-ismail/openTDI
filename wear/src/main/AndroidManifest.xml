<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="com.samsung.android.hardware.sensormanager.permission.READ_ADDITIONAL_HEALTH_DATA" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission
        android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The watch alarms: vibration, and a full-screen alarm when the screen is off. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The morning dream report, recorded on the watch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The wake-up alarm's system-owned backup (WakeBackup): an alarm clock that still rings when the app's process is
         gone. Granted at install to alarm-clock apps and not revocable (API 33+); Wear OS 3 (API 30) needs none. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- A restart clears every alarm: the backup is put back from its saved record. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The backup rings from a systemExempted foreground service: open to apps holding USE_EXACT_ALARM, and unlike
         health it needs no sensor permission when an alarm starts it from the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- add only if spec §15 #4 shows PERMISSION_ERROR with the screen off:
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" /> -->

    <!-- Health Sensor Service (Health Platform); the AAR's manifest adds the same entry, stub builds need it here -->
    <queries>
        <package android:name="com.samsung.android.service.health" />
        <!-- What the Samsung SDK's own manifest asks for: Galaxy Store, to install Health Sensor Service. -->
        <package android:name="com.sec.android.app.samsungapps" />
    </queries>

    <!-- Session logs and dream recordings are personal: no cloud backup, no device-to-device transfer. On API 30
         allowBackup="false" alone does that, so no fullBackupContent file is needed. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault"
        tools:ignore="DataExtractionRules">

        <!-- Phase 1 runs without the phone -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The phone's Start the night opens the app here (RemoteActivityHelper); the phone then starts the night.
                 Any app could send this link: it only opens the app, which then waits for the phone. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opentdi" android:host="tonight" />
            </intent-filter>
        </activity>

        <service
            android:name=".sensing.HealthTrackingForegroundService"
            android:exported="false"
            android:foregroundServiceType="health|systemExempted" />

        <!-- The wake-up alarm's backup firing: only this app's own alarm sends it. Direct boot aware, with its record
             in device-protected storage, so before the first unlock after a restart it still rings as a notification. -->
        <receiver
            android:name=".alarm.WakeBackupReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Puts the backup back after a restart (which clears every alarm) or an update. Exported because the system
             sends these; only it can, and nothing else is acted on. -->
        <receiver
            android:name=".alarm.WakeBackupBootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The user's own Samsung kit, converted and sent by the phone (bring your own kit). -->
        <service
            android:name=".link.KitReceiverService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:path="/opentdi/samsung_kit"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- The phone's Start session, Stop watch recording and status requests (sendRequest). -->
        <service
            android:name=".link.PhoneCommandService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/opentdi/state_command"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- The wrist speaker: Play Services starts it when the phone opens the cue channel. -->
        <service
            android:name=".link.WristSpeakerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:path="/opentdi/wrist_audio_channel"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- The night files, copied to the phone when the phone opens the session files channel. -->
        <service
            android:name=".link.SessionFilesService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:path="/opentdi/session_files"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
